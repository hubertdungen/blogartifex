# Optional local overrides. Normal users can run BlogArtifex without this file.

# Optional custom Google OAuth Client ID.
# Leave unset to use BlogArtifex's bundled client ID.
# REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional local production server port used by npm run serve or release binaries.
# PORT=3000

# Optional scheduler settings used by npm run scheduler.
# BLOGGER_TOKEN=
# SCHEDULED_POSTS_FILE=scheduled-posts.json

# Optional: keeps you signed in for months instead of one hour. The client secret of
# the same OAuth client (Google Cloud console → Credentials → your Web client).
# It is only read by server.js and never reaches the browser.
GOOGLE_CLIENT_SECRET=
