{
  "name": "blogartifex",
  "version": "2.1.0",
  "description": "Um editor avan\u00e7ado para o Blogger com recursos modernos e integra\u00e7\u00e3o completa",
  "private": true,
  "homepage": ".",
  "scripts": {
    "start": "react-scripts start",
    "dev": "npm start",
    "build": "react-scripts build",
    "serve": "node server.js",
    "release": "node build-release.js --target win",
    "release:win": "node build-release.js --target win",
    "release:current": "node build-release.js --target current",
    "release:linux": "node build-release.js --target linux",
    "release:macos": "node build-release.js --target macos",
    "release:all": "node build-release.js --target all",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "scheduler": "node scheduler.js",
    "voice:setup": "python3 voice/setup.py",
    "test:voice": "node --test tests/voiceService.test.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@ckeditor/ckeditor5-react": "^11.2.0",
    "@react-oauth/google": "^0.12.1",
    "ckeditor5": "^48.5.2",
    "file-saver": "^2.0.5",
    "mammoth": "^1.13.0",
    "node-schedule": "^2.1.1",
    "react": "^18.2.0",
    "react-datetime-picker": "^5.5.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "react-scripts": "^5.0.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@capacitor/cli": "^6.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/file-saver": "^2.0.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "pkg": "^5.8.1",
    "pkg-fetch": "^3.4.2",
    "rcedit": "^4.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^ckeditor5(/.*)?$": "<rootDir>/src/testStubs/ckeditor.js",
      "^@ckeditor/ckeditor5-react$": "<rootDir>/src/testStubs/ckeditor.js"
    }
  },
  "proxy": "http://localhost:3000"
}
